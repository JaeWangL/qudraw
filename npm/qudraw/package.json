{
  "name": "qudraw",
  "version": "0.1.0",
  "description": "A React drawing canvas with opt-in responsive notebook handwriting and Apple Pencil palm isolation, built from Excalidraw.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaewangl/qudraw.git"
  },
  "bugs": "https://github.com/jaewangl/qudraw/issues",
  "homepage": "https://github.com/jaewangl/qudraw#readme",
  "keywords": [
    "drawing",
    "handwriting",
    "canvas",
    "react",
    "apple-pencil",
    "excalidraw"
  ],
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "types": "./dist/types/excalidraw/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/excalidraw/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./index.css": {
      "development": "./dist/dev/index.css",
      "default": "./dist/prod/index.css"
    },
    "./types": {
      "types": "./dist/types/excalidraw/types.d.ts"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/types/excalidraw/*.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "dist/types/*": [
        "dist/types/*"
      ],
      "*": [
        "dist/types/excalidraw/*"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "UPSTREAM.json",
    "FONT_LICENSES",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
